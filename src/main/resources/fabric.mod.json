{
  "schemaVersion": 1,
  "id": "litematica_printer",
  "version": "${mod_version}",
  "name": "Litematica Printer",

  "description": "A fork of Litematica that adds the missing printer functionality",
  "authors": [
    "aleksilassila"
  ],
  "contact": {
    "homepage": "https://github.com/aleksilassila/litematica-printer",
    "sources": "https://github.com/aleksilassila/litematica-printer"
  },
  "license": "CC0-1.0",
  "icon": "assets/litematica-printer/icon.png",

  "environment": "client",
  "entrypoints": {
    "main": [
      "me.aleksilassila.litematica.printer.LitematicaMixinMod"
    ]
  },
  "mixins": [
    "litematica-printer.mixins.json",
    "litematica-printer-implementation.mixins.json"
  ],

  "depends": {
    "minecraft": ">=26.2 <26.3",
    "malilib": ">=0.29.0- <0.30.0-",
    "litematica": ">=0.28.0- <0.29.0-"
  },
  "breaks": {
    "malilib": "<0.29.0-",
    "litematica": "<0.28.0-"
  },

  "custom": {
    "modmenu": {
      "parent": "litematica"
    }
  }
}
